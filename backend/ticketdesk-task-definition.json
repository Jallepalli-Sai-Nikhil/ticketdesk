{
  "family": "ticketdesk-m0-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::473009222991:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "ticketdesk-backend",
      "image": "473009222991.dkr.ecr.ap-south-1.amazonaws.com/ticketdesk-backend:m0",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ]
    }
  ]
}
